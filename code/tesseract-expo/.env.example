# Copy to .env and fill in. .env is gitignored; never commit a filled-in copy.
#
# Expo inlines EXPO_PUBLIC_* variables into the bundle at build time, so only
# PUBLIC client identifiers belong here. Service-account keys, database URLs
# and AI-provider keys stay on the backend and must never appear in this file.

# Public Firebase Web API key. This is a public client identifier, not a
# secret: it identifies the project to Google's identity endpoints and is
# designed to ship inside clients.
EXPO_PUBLIC_FIREBASE_API_KEY=

# HTTPS base URL of the Tesseract API. Must be https:// — iOS App Transport
# Security blocks plain HTTP, and an identity token must never travel in the
# clear. A local backend needs a tunnel.
EXPO_PUBLIC_TESSERACT_API_URL=
