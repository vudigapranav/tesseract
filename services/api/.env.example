# Tesseract API environment template.
# Copy to .env and fill in. NEVER commit the filled-in .env — it is gitignored.
# Every value below is a placeholder. No real credential belongs in this file.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local development against a homebrew/system PostgreSQL:
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/tesseract

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# firebase -> real Firebase ID token verification. Required when APP_ENV=production.
# demo     -> accepts synthetic "demo:<auth_uid>" tokens. Refused in production;
#             the service will not start. For local development and the
#             synthetic hackathon demo only.
AUTH_MODE=demo

# Only read when AUTH_MODE=firebase. Path to the Firebase service-account JSON.
# Keep this file outside the repository. Do not paste its contents anywhere.
# FIREBASE_CREDENTIALS_FILE=/absolute/path/outside/repo/serviceAccount.json
# FIREBASE_PROJECT_ID=REPLACE_FIREBASE_PROJECT_ID

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# Local filesystem root for the prototype's authorized media adapter.
# Access is still membership-checked on every read; this is not a public bucket.
MEDIA_ROOT=./var/media
MEDIA_MAX_BYTES=5242880

# ---------------------------------------------------------------------------
# Optional LLM summary text (off by default)
# ---------------------------------------------------------------------------
# When false, all caregiver/doctor summary text comes from deterministic
# templates. The LLM may only rephrase already-computed, de-identified facts.
LLM_ENABLED=false
# The only implemented provider. See app/llm/providers.py.
# LLM_PROVIDER=gemini
# Any model id your key can reach. List them with:
#   curl -H "x-goog-api-key: $LLM_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
# LLM_MODEL=REPLACE_MODEL_ID
# Server-side only. Never an EXPO_PUBLIC_ variable, never in the mobile bundle.
# LLM_API_KEY=REPLACE_API_KEY
# Measured round trip for a Gemini 3 flash model was 11-12s, so 8s was not
# enough. A timeout is not a failure: the report falls back to the template.
LLM_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
